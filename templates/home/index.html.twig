{% extends 'base.html.twig' %}

{% block title %}Page d'accueil{% endblock %}

{% block body %}

	<div class="container">

		<div class="row g-4">
<pre>
    {{ dump(students) }}
</pre>
			{% for student in students %}

				<div class="col-12 col-md-6 col-lg-4">

					<div class="card h-100">

						<img
							class="card-img-top"
							src="https://picsum.photos/200/200"
							alt="Photo de {{ student.firstName }}"
						>

						<div class="card-body">
<div class="d-flex flex-column gap-2">
							<h5 class="card-title">
								{{ student.firstName ~ " " ~ student.lastName }}
							</h5>
<span class="card-text">{{student.email }}</span>
<span class="card-text">Date de naissance : {{student.birthDate|date('d/m/Y') }}</span>
<span class="card-text">Nombre absence : {{student.countAbsences }}</span>
<a href="#" class="btn btn-warning">Editer</a>
<a href="#" class="btn btn-danger">Supprimer</a>
</div>
						</div>

					</div>

				</div>

			{% endfor %}

		</div>

	</div>

{% endblock %}
