{% extends 'base.html.twig' %}

{% block title %}Absence{% endblock %}

{% block body %}
<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-6">

            {{ form_start(form) }}
                {{ form_row(form.absenceDate) }}
                {{ form_row(form.student) }}
                {{ form_row(form.reason) }}

                <button class="btn btn-primary">Enregistrer</button>
                <a href="{{ path('app_absence_index') }}" class="btn btn-secondary">Annuler</a>
            {{ form_end(form) }}

        </div>
    </div>
</div>
{% endblock %}