<!DOCTYPE html>
<html lang="fr">
	<head>
		<meta charset="UTF-8">
		<meta name="viewport" content="width=device-width, initial-scale=1">
		<title>{% block title %}Gestion des absences{% endblock %}</title>
<link href="{{ asset('assets/css/bootstrap.min.css') }}" rel="stylesheet">
		{% block stylesheets %}{% endblock %}
	</head>
	<body class="bg-body-tertiary">
		{{ include('partials/_navbar.html.twig') }}
<div class="container">
    {% for message in app.flashes('success') %}
        <div class="alert alert-success">{{ message }}</div>
    {% endfor %}
</div>
		{% block body %}{% endblock %}

		<div class="offcanvas offcanvas-end" tabindex="-1" id="statsPanel" aria-labelledby="statsPanelLabel">
			<div class="offcanvas-header">
				<h5 class="offcanvas-title" id="statsPanelLabel">Statistiques</h5>
				<button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Fermer"></button>
			</div>
			<div class="offcanvas-body">
				{% block stats %}
					<p class="text-muted">Statistiques indisponibles sur cette page.</p>
				{% endblock %}
			</div>
		</div>

<script src="{{ asset('assets/js/bootstrap.bundle.min.js') }}"></script>
	</body>
</html>